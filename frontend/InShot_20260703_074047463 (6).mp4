import React from 'react'
import { useNavigate } from 'react-router-dom'
import './generatelinkbtnbox.css'

const generatelinkbtnbox = () => {
  const navigate = useNavigate()

  return (
    <section className="share-card" aria-labelledby="share-card-title">
      <div className="share-card-text">
        <h2 id="share-card-title">Share and earn</h2>
        <p>Invite friends to Empty Store with your own link.</p>
      </div>
      <button type="button" onClick={() => navigate('/shareAndEarn')}>
        Open Share and Earn
      </button>
    </section>
  )
}

export default generatelinkbtnbox
